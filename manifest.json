{
  "manifestVersion": 5,
  "id": "com.creatix.moonberry.tool",
  "name": "Moonberry Tool",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "23.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "moonberryPanel",
      "label": {
        "default": "Moonberry Tool"
      },
      "minimumSize": {
        "width": 320,
        "height": 480
      },
      "maximumSize": {
        "width": 640,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 350,
        "height": 650
      },
      "icons": [
        {
          "width": 48,
          "height": 48,
          "path": "icons/icon.png"
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon.png"
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "all"
      ]
    },
    "clipboard": "readAndWrite",
    "localFileSystem": "fullAccess"
  }
}
